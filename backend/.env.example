APP_ENV=development
# Orígenes y hosts explícitos. NUNCA uses '*' en producción.
CORS_ORIGINS_RAW=http://localhost:3000
ALLOWED_HOSTS_RAW=localhost,127.0.0.1
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=documents
WEAVIATE_URL=
WEAVIATE_API_KEY=
MAX_UPLOAD_MB=50

# Base de datos local de autenticación (ruta absoluta recomendada en producción)
MIPYMES_AUTH_DB=

# Correos (separados por coma) que obtienen rol admin al registrarse
ADMIN_EMAILS=
