# =============================================================================
# MiPymes Frontend — Variables de entorno para producción
# Copia este archivo a .env.local y rellena los valores reales.
# =============================================================================

# URL pública de la aplicación (usada en cookies, redirects, canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL del backend FastAPI (desplegado por separado)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (cliente del navegador — usar anon key, NUNCA service_role)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Seguridad
NEXTAUTH_SECRET=genera-un-secreto-aleatorio-de-al menos-32-caracteres
NEXTAUTH_URL=http://localhost:3000

# Monitoreo (opcional en dev, obligatorio en producción)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Analytics (opcional)
NEXT_PUBLIC_ANALYTICS_ID=

# Hugging Face Inference API (gratuito con límites)
# Obtén tu clave en: https://huggingface.co/settings/tokens
# ⚠️ ROTA esta clave si la compartiste en chats públicos
NEXT_PUBLIC_HF_API_KEY=tu-clave-de-hugging-face-aqui
NEXT_PUBLIC_HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
