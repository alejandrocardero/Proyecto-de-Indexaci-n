# =============================================================================
# MiPymes Frontend — Variables de entorno para producción
# Copia este archivo a .env.local y rellena los valores reales.
# =============================================================================

# URL pública de la aplicación (usada en cookies, redirects, canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL del backend FastAPI (desplegado por separado)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (cliente del navegador — usar anon key, NUNCA service_role)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Seguridad (la sesión se gestiona con cookies HttpOnly emitidas por el backend)
NEXTAUTH_URL=http://localhost:3000

# Analytics (opcional)
NEXT_PUBLIC_ANALYTICS_ID=

# Hugging Face (SOLO servidor; NUNCA con prefijo NEXT_PUBLIC_)
# La inferencia actual usa modelos ONNX locales y no requiere clave.
# Si habilitas la API remota, define HF_API_KEY en el backend, no aquí.
HF_API_KEY=
NEXT_PUBLIC_HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
